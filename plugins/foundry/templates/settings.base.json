{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(Remove-Item -Recurse -Force *)"
    ]
  }
}
